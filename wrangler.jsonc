{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "benefits-intake-qa",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Optional OpenAI second opinion. Every paid call first reserves its worst-case cost in
  // the BudgetGate Durable Object (lifetime cap, fail closed). Configure OPENAI_API_KEY as a
  // secret and OPENAI_MODEL, OPENAI_INPUT_USD_PER_MTOK, OPENAI_OUTPUT_USD_PER_MTOK and
  // AI_LIFETIME_BUDGET_USD as variables; if any is missing the app runs rules only.
  "durable_objects": {
    "bindings": [{ "name": "BUDGET_GATE", "class_name": "BudgetGate" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BudgetGate"] }],
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
