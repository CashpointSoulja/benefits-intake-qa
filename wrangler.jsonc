{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "benefits-intake-qa",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Workers AI is optional: the engine falls back to deterministic extraction when
  // the binding is absent or the model call fails.
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
